<Window x:Class="NativeApp.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pipeline workspace" Height="720" Width="1120" MinHeight="600" MinWidth="900" Background="#F7F8FC" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="22"/><Setter Property="Margin" Value="0,0,16,16"/></Style>
        <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="#687386"/><Setter Property="FontSize" Value="14"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#111827" Padding="32,0"><Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" Background="#6D5DFB" CornerRadius="10" Margin="0,0,12,0"><TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Pipeline" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="Tuesday, September 9" Foreground="#AEB7C8" FontSize="13" VerticalAlignment="Center" Margin="0,0,22,0"/><Border Background="#263247" CornerRadius="18" Padding="12,7"><TextBlock Text="JD  Jon Doe" Foreground="White" FontSize="13"/></Border></StackPanel>
        </Grid></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><Grid Margin="32,30,16,30" MaxWidth="1056" HorizontalAlignment="Center">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,24"><TextBlock Text="Good morning, Jon" FontSize="32" FontWeight="SemiBold" Foreground="#182230"/><TextBlock Text="Here’s what’s happening across your workspace today." Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel>
            <Border Grid.Row="1" Background="#EAE8FF" CornerRadius="16" Padding="26" Margin="0,0,0,22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your workspace is ready" FontSize="22" FontWeight="SemiBold" Foreground="#28215D"/><TextBlock Text="Connect your first pipeline and keep every handoff moving." FontSize="14" Foreground="#59528D" Margin="0,8,0,18"/><Button Content="Create a pipeline" Click="CreatePipeline_Click" Background="#6D5DFB" Foreground="White" BorderThickness="0" Padding="18,10" HorizontalAlignment="Left" FontWeight="SemiBold" Cursor="Hand"/></StackPanel><TextBlock Grid.Column="1" Text="✦" FontSize="72" Foreground="#B5AEFF" VerticalAlignment="Center" Margin="30,0,12,0"/></Grid></Border>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><TextBlock Text="Overview" FontSize="18" FontWeight="SemiBold" Foreground="#182230" Margin="0,0,0,12"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Active pipelines" Style="{StaticResource MutedText}"/><TextBlock Text="0" FontSize="30" FontWeight="SemiBold" Foreground="#182230" Margin="0,10,0,0"/><TextBlock Text="Start by creating one" Foreground="#6D5DFB" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Tasks completed" Style="{StaticResource MutedText}"/><TextBlock Text="0" FontSize="30" FontWeight="SemiBold" Foreground="#182230" Margin="0,10,0,0"/><TextBlock Text="No activity yet" Foreground="#687386" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
                    <Border Grid.Column="2" Style="{StaticResource Card}"><StackPanel><TextBlock Text="Team members" Style="{StaticResource MutedText}"/><TextBlock Text="1" FontSize="30" FontWeight="SemiBold" Foreground="#182230" Margin="0,10,0,0"/><TextBlock Text="Just you for now" Foreground="#687386" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
                </Grid></StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Card}" Margin="0,30,0,16"><StackPanel><Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="API connection" FontSize="18" FontWeight="SemiBold" Foreground="#182230" VerticalAlignment="Center"/><Button Grid.Column="1" Content="Refresh" Click="RefreshApi_Click" Padding="10,5" Margin="12,0,0,0" Background="White" Foreground="#6D5DFB" BorderBrush="#D9D5FF" Cursor="Hand"/></Grid><TextBlock x:Name="ApiStatusText" Text="Connecting to the API…" Foreground="#687386" FontSize="14" Margin="0,0,0,13"/><TextBlock x:Name="WeatherSummaryText" Text="Waiting for data" Foreground="#344054" FontSize="14" TextWrapping="Wrap"/></StackPanel></Border>
            </Grid>
        </Grid></ScrollViewer>
    </Grid>
</Window>
